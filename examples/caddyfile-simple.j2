# ============================================================================
# Пример простого Caddyfile для ноды
# ============================================================================
# Использование: templates/caddyfiles/YOUR_NODE.j2
# ============================================================================

# Один домен на стандартном HTTPS порту (443)
https://cdn.example.com {
    tls {
        dns cloudflare {
            api_token {{ cloudflare_api_token }}
        }
    }

    # Статический файловый сервер
    root * /srv/static-site
    file_server
}

