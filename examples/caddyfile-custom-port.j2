# ============================================================================
# Пример Caddyfile с кастомным портом
# ============================================================================
# Полезно если на сервере несколько прокси на разных портах
# ============================================================================

{
    # Глобальные настройки для всех сайтов
    servers {
        protocols h1 h2 h3  # HTTP/1.1, HTTP/2, HTTP/3 (QUIC)
        timeouts {
            read_body 60s
            read_header 20s
            idle 2m
        }
    }
}

# Домен на кастомном порту 8443
https://cdn-node1.example.com:8443 {
    root * /srv/static-site
    file_server
}

