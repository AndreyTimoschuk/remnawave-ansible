# ============================================================================
# Environment variables for RemnaWave Panel
# ============================================================================
# ВАЖНО: Замените все CHANGE_ME значения на свои перед развертыванием!
# Документация: https://remna.st/docs/install/environment-variables
# ============================================================================

### APP ###
APP_PORT=3000
METRICS_PORT=3001

### API ###
# Possible values: max (start instances on all cores), number (start instances on number of cores), -1 (start instances on all cores - 1)
# !!! Do not set this value more than physical cores count in your machine !!!
# Review documentation: https://remna.st/docs/install/environment-variables#scaling-api
API_INSTANCES=1

### DATABASE ###
# FORMAT: postgresql://{user}:{password}@{host}:{port}/{database}
DATABASE_URL=postgresql://{{ postgres_user }}:{{ postgres_password }}@127.0.0.1:5432/{{ postgres_db }}?schema=public

### REDIS ###
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

### JWT ###
# CHANGE DEFAULT VALUES - сгенерируйте безопасные ключи
# Генерация: openssl rand -hex 64
JWT_AUTH_SECRET={{ jwt_auth_secret }}
JWT_API_TOKENS_SECRET={{ jwt_api_tokens_secret }}

### TELEGRAM NOTIFICATIONS ###
# Уведомления о событиях в Telegram
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_NOTIFY_USERS_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_NOTIFY_NODES_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

### Telegram OAuth (Login with Telegram) ###
TELEGRAM_OAUTH_ENABLED=false
# Array of Admin Chat Ids. These ids will be allowed to login.
TELEGRAM_OAUTH_ADMIN_IDS=[]

# Optional - если используете topics в Telegram
TELEGRAM_NOTIFY_USERS_THREAD_ID=
TELEGRAM_NOTIFY_NODES_THREAD_ID=

### FRONT_END ###
# Used by CORS, you can leave it as * or place your domain there
FRONT_END_DOMAIN={{ remnawave_panel_domain }}

### SUBSCRIPTION PUBLIC DOMAIN ###
# DOMAIN, WITHOUT HTTP/HTTPS, DO NOT ADD / AT THE END
# Used in "profile-web-page-url" response header and in UI/API
# Review documentation: https://remna.st/docs/install/environment-variables#domains
{% if sub_public_domain is defined and sub_public_domain %}
SUB_PUBLIC_DOMAIN={{ sub_public_domain }}
{% else %}
SUB_PUBLIC_DOMAIN={{ remnawave_panel_domain }}
{% endif %}

### If CUSTOM_SUB_PREFIX is set in @remnawave/subscription-page, append the same path to SUB_PUBLIC_DOMAIN
### Example: SUB_PUBLIC_DOMAIN=sub-page.example.com/sub

### SWAGGER ###
SWAGGER_PATH=/docs
SCALAR_PATH=/scalar
IS_DOCS_ENABLED=true

### PROMETHEUS ###
# Metrics are available at /api/metrics
# Password должен быть SHA-512 hash
# Шаг 1: Выберите пароль (например: openssl rand -base64 24)
# Шаг 2: Создайте hash: echo -n 'your_password' | sha512sum | cut -d' ' -f1
METRICS_USER={{ prometheus_remnawave_username }}
METRICS_PASS={{ prometheus_remnawave_password }}

### WEBHOOK ###
# Webhook для интеграции с внешними сервисами
WEBHOOK_ENABLED=false
# Only https:// is allowed
WEBHOOK_URL=https://webhook.site/your-webhook-id
# This secret is used to sign the webhook payload, must be exact 64 characters. Only a-z, 0-9, A-Z are allowed.
# Генерация: openssl rand -base64 48 | tr -d '=+/' | cut -c1-64
WEBHOOK_SECRET_HEADER=CHANGE_ME_64_CHARS_ONLY_ALPHANUMERIC_WEBHOOK_SECRET_HERE

### HWID DEVICE DETECTION AND LIMITATION ###
# Don't enable this if you don't know what you are doing.
# Review documentation before enabling this feature.
# https://remna.st/docs/features/hwid-device-limit/
HWID_DEVICE_LIMIT_ENABLED=false
HWID_FALLBACK_DEVICE_LIMIT=5
HWID_MAX_DEVICES_ANNOUNCE=You have reached the device limit.

### Bandwidth usage reached notifications ###
BANDWIDTH_USAGE_NOTIFICATIONS_ENABLED=false
# Only in ASC order (example: [60, 80]), must be valid array of integer(min: 25, max: 95) numbers. No more than 5 values.
BANDWIDTH_USAGE_NOTIFICATIONS_THRESHOLD=[60, 80]

### CADDY AUTH API TOKEN ###
# Token для интеграции с Caddy authentication
# Генерируется автоматически панелью, можно оставить пустым
CADDY_AUTH_API_TOKEN=

### Database для Postgres контейнера ###
# NOT USED BY THE APP ITSELF - используется только Docker контейнером
# Генерация пароля: openssl rand -base64 24
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db }}
